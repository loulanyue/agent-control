# ==========================================
# Agent Control Environment Configuration
# ==========================================

# Application Settings
APP_NAME="Agent Control Plane"
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database Configuration
# Option A: SQLite (Quickstart, no external DB needed)
# DATABASE_URL=sqlite:///./agent_control.db

# Option B: MySQL (Production / Default)
DB_HOST=127.0.0.1
DB_PORT=13306
DB_USER=root
DB_PASSWORD=
DB_NAME=agent_control
DB_ECHO=false

# Task Lease & Heartbeat Settings (Seconds)
DEFAULT_TASK_LEASE_SECONDS=300
HEARTBEAT_THRESHOLD_SECONDS=60

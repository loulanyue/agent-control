# ==========================================
# Agent Control Environment Configuration
# ==========================================

# Application Settings
APP_NAME="Agent Control Plane"
APP_ENV=development
DEBUG=true
PORT=8000
# 安全加固：默认监听 127.0.0.1（避免未鉴权直接暴露于 0.0.0.0 公网）
HOST=127.0.0.1

# Security & Authentication (CWE-306 防御)
# 设置 Master API Key (Bearer Token 或 X-API-Key)
API_KEY=ac_your_strong_secret_key_here
REQUIRE_AUTH=true
# 限制允许的跨域前端来源（禁止通配符 * 携带凭证）
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173

# Database Configuration
# Option A: SQLite (Quickstart, no external DB needed)
# DATABASE_URL=sqlite:///./agent_control.db

# Option B: MySQL (Production / Default)
DB_HOST=127.0.0.1
DB_PORT=13306
DB_USER=root
DB_PASSWORD=
DB_NAME=agent_control
DB_ECHO=false

# Task Lease & Heartbeat Settings (Seconds)
DEFAULT_TASK_LEASE_SECONDS=300
HEARTBEAT_THRESHOLD_SECONDS=60

